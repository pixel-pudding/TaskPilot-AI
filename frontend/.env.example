# Absolute backend URL. Required when frontend and backend are deployed to
# different origins (e.g. frontend on Vercel, backend on Railway/Render).
# Leave unset/commented for same-origin deploys (e.g. docker-compose, where
# nginx proxies /api and /ws to the backend container on the same origin).
VITE_API_BASE_URL=https://your-backend.up.railway.app
