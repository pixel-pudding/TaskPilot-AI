# ─── LLM Configuration ─────────────────────────────────────────────────────
# PRIMARY LLM — Grok (xAI)
LLM_API_KEY=Your_Grok_API_Key_Here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
# FALLBACK LLM — Gemini
GEMINI_API_KEY=Your_Gemini_API_Key_Here
GEMINI_MODEL=gemini-2.5-flash

# ─── Connector Credentials ─────────────────────────────────────────────────
# Jira
JIRA_URL=https://aditianand-taskpilot.atlassian.net
JIRA_EMAIL=aditianandkumar@gmail.com
JIRA_API_TOKEN=Your_JIRA_API_TOKEN_Here

# GitHub
GITHUB_TOKEN=Your_GITHUB_TOKEN_Here
GITHUB_REPO_OWNER=taskpilot-ai
GITHUB_REPO_NAME=backend

# Outlook (Microsoft Graph)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_USER_EMAIL=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ServiceNow
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# ─── Database ──────────────────────────────────────────────────────────────
# Set DATABASE_URL for PostgreSQL; leave empty to use SQLite
DATABASE_URL=postgresql+asyncpg://taskpilot:taskpilot@localhost:5432/taskpilot
# DATABASE_URL=sqlite+aiosqlite:///db/taskpilot.db

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_RATE_LIMIT_PER_MINUTE=60

# ─── Embedding Model ───────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_CACHE_ENABLED=true

# ─── Monitoring ────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
OTEL_SERVICE_NAME=taskpilot-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text

# ─── Pipeline ──────────────────────────────────────────────────────────────
EXTRACTION_CONFIDENCE_THRESHOLD=0.50
PIPELINE_SYNC_INTERVAL_MINUTES=15
MAX_CONCURRENT_SYNCS=3